# --- Kiosk ERP API — local development environment ---
# Copy to .env for local dev. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgres://kiosk:kiosk@localhost:5432/kiosk_erp

# Access-token signing secret (HS256). Use a long random value in any shared env.
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900

# Licensing: path to the ES256 signing keypair (PEM). Generated by
#   npm --workspace apps/api run licensing:keys
# The private key must NEVER be committed or shipped in a client binary.
LICENSE_SIGNING_PRIVATE_KEY_PATH=./.secrets/license-signing.key.pem
LICENSE_SIGNING_PUBLIC_KEY_PATH=./.secrets/license-signing.pub.pem
LICENSE_SIGNING_KID=dev-2026-10

# Comma-separated allowed CORS origins (blank = none)
CORS_ORIGINS=
